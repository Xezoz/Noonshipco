# Coinbase Commerce API key used to initialise the SDK client
COINBASE_CLIENT=your_coinbase_api_key

# Frontend origin allowed to access the API (e.g. https://app.example.com)
CORS_HOST=http://localhost:5173

# AWS credentials for the S3 bucket that stores user images
AWS_ACCESSKEYID=your_access_key_id
AWS_SECRETACCESSKEY=your_secret_access_key
AWS_REGION=us-east-1

# Session configuration
SESSION_KEY=userId
SESSION_SECRET=super_secret_session_value

# MySQL connection settings
DB_HOST=localhost
DB_USERNAME=mership
DB_PASSWORD=super_secure_password
DB_DATABASE=mership

# Coinbase webhook secret for validating payment events
COINBASE_WEBHOOK_SECRET=your_webhook_secret

# Percentage fee applied to packages (e.g. 15 for 15%)
PACKAGE_FEES=15

# Optional: override the Express listen port (defaults to 5080 if unset)
# PORT=5080
